# Model paths
MODEL_ARTIFACTS_DIR=../FINAL_FEDERATED_QWEN_JEV_V2
BASE_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Server
HOST=0.0.0.0
PORT=8000

# Device (cuda or cpu)
DEVICE=cuda

# Max tokens for generation
MAX_NEW_TOKENS=512

# Concurrency strategy: "sequential" or "concurrent"
# sequential = share single base model, swap adapters (memory-safe)
# concurrent = attempt parallel execution (requires more VRAM)
CONCURRENCY_STRATEGY=sequential
